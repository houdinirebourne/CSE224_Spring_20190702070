digraph "TopModule" {
label="TopModule";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="isImmediate", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="Result", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="B", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="A", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="imm", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="rd", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="rs2", color="black", fontcolor="black" ];
n8 [ shape=diamond, label="rs1", color="black", fontcolor="black" ];
n9 [ shape=diamond, label="ALUop", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="instr", color="black", fontcolor="black" ];
n11 [ shape=diamond, label="pc", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="control", color="black", fontcolor="black" ];
n13 [ shape=octagon, label="reset", color="black", fontcolor="black" ];
n14 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c16 [ shape=record, label="{{<p4> A|<p9> ALUop|<p3> B|<p15> Imm}|alu\nALU|{<p2> Result}}",  ];
v0 [ label="1'1" ];
c24 [ shape=record, label="{{<p14> clk|<p17> readReg1|<p18> readReg2|<p19> regWrite|<p20> writeData|<p21> writeReg}|regfile\nRegisterFile|{<p22> readData1|<p23> readData2}}",  ];
c25 [ shape=record, label="{{<p10> instr}|decoder\nDecoder|{<p9> ALUop|<p5> imm|<p1> isImmediate|<p6> rd|<p8> rs1|<p7> rs2}}",  ];
c27 [ shape=record, label="{{<p26> addr}|imem\nInstructionMemory|{<p10> instr}}",  ];
c28 [ shape=record, label="{{<p14> clk|<p12> control|<p13> reset}|pc_module\nProgramCounter|{<p11> pc}}",  ];
c25:p1:e -> n1:w [color="black", fontcolor="black", label=""];
c27:p10:e -> n10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n10:e -> c25:p10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c28:p11:e -> n11:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n11:e -> c27:p26:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n12:e -> c28:p12:w [color="black", fontcolor="black", label=""];
n13:e -> c28:p13:w [color="black", fontcolor="black", label=""];
n14:e -> c24:p14:w [color="black", fontcolor="black", label=""];
n14:e -> c28:p14:w [color="black", fontcolor="black", label=""];
c16:p2:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c24:p20:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c24:p23:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c16:p3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c24:p22:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c16:p4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c25:p5:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c16:p15:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c25:p6:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c24:p21:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c25:p7:e -> n7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n7:e -> c24:p18:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c25:p8:e -> n8:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n8:e -> c24:p17:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c25:p9:e -> n9:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n9:e -> c16:p9:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
v0:e -> c24:p19:w [color="black", fontcolor="black", label=""];
}
